{
  "name": "nba-mvp-tracker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/api/index.js",
    "start-server": "ts-node src/api/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-season": "ts-node scripts/build-season.ts",
    "generate-two-player-fixture": "ts-node scripts/generate-two-player-fixture.ts",
    "generate-fixture": "ts-node scripts/generate-fixture.ts",
    "fetch-game-logs": "ts-node scripts/fetch-game-logs.ts",
    "fetch-summaries": "ts-node scripts/fetch-game-summaries.ts",
    "resolve-highlights": "ts-node scripts/resolve-highlights.ts",
    "add-highlight": "ts-node scripts/add-highlight.ts",
    "migrate": "ts-node scripts/migrate-formula-v2.ts",
    "cleanup": "ts-node scripts/cleanup-legacy-data.ts",
    "validate-estimates": "ts-node scripts/validate-estimates.ts",
    "verify-db": "ts-node scripts/verify-database.ts",
    "verify-games": "ts-node scripts/verify-game-data.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/node": "^18.6.1",
    "cheerio": "^1.2.0",
    "react": "^19.2.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongodb": "^6.2.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "zod": "^4.1.13"
  }
}
